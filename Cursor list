#include<stdio.h>
#define MAX 10
#define TOP 100000


typedef struct{
    int data;
    int next;
}Stype;

typedef struct{
    Stype elems[MAX];
    int avail;
}VHeap;

void initVSpace(VHeap *vh){
    
    for(int i = MAX - 1; i >= 0; --i){
        vh->elems[i].next = i - 1;
        vh->elems[i].data = 0;
    }
    vh->avail = MAX - 1;

    
}

int allocSpace(VHeap *vh){
    int retVal = vh->avail;
    
    if(retVal != -1){
        retVal = vh->elems[retVal].next;
    } 
    return retVal;
}

void freeSpace(VHeap *vh, int index){
    if(index != -1 && index < MAX){
        vh->elems[index].next = vh->avail;
        vh->avail = index;
    }
    

}

void visualize(VHeap vh){
    printf("%10s | %10s | %10s\n", "index", "data", "next");
    for(int i = 0; i < MAX; ++i){
        printf("%10d | %10d | %10d\n", i ,vh.elems[i].data, vh.elems[i].next);
    }
    printf("\nAvail: %d", vh.avail);
}

int main(){
    VHeap VH;
    initVSpace(&VH);
    visualize(VH);
    
}


